{
  "name": "co-driver-rally",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Co-Driver Rally \u2013 a cooperative 3D rally game: up to four players: drivers race each other, navigators call the road from a second device.",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c red,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "typecheck": "tsc -p shared --noEmit && tsc -p server --noEmit && tsc -p client --noEmit",
    "test": "npm run test:server && npm run test:track",
    "test:server": "tsx tests/server.test.ts",
    "test:track": "tsx tests/track.test.ts",
    "test:physics": "tsx tests/physics.test.ts",
    "test:rollover": "tsx tests/rollover.test.ts",
    "test:handling": "tsx tests/handling.test.ts",
    "test:ai": "tsx tests/ai.test.ts",
    "test:straight": "tsx tests/straight.test.ts",
    "test:turns": "tsx tests/turnjitter.test.ts",
    "test:camera": "tsx tests/camera.test.ts",
    "test:career": "tsx tests/career.test.ts",
    "test:championship": "tsx tests/championship.test.ts",
    "test:multiplayer": "tsx tests/multiplayer.test.ts",
    "render-build": "npm install --include=dev && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
